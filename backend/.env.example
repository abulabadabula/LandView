# Required for LINZ addresses, parcels and building footprints.
LINZ_API_KEY=

# Comma-separated browser origins allowed by FastAPI CORS.
CORS_ORIGINS=http://localhost:5173

# LINZ Data Service layer IDs.
LINZ_ADDRESS_LAYER=123113
LINZ_PARCEL_LAYER=50772
LINZ_BUILDING_LAYER=101290

# Optional: change the public Overpass endpoint if required by local policy.
OVERPASS_URL=https://overpass-api.de/api/interpreter

HTTP_TIMEOUT=20

# LINZ Basemaps API key (https://basemaps.linz.govt.nz) - used for national LiDAR DEM/DSM Terrain-RGB tiles.
# Enables high-resolution local terrain and indicative building heights from DSM minus DEM samples.
# Without it, terrain and heights use coarse/OSM fallback data.
LINZ_BASEMAPS_KEY=
