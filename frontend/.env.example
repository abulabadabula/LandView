VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Optional: LINZ Basemaps key (aerial + topographic tiles). Falls back to OpenStreetMap.
VITE_LINZ_BASEMAPS_KEY=
# Optional: Cesium ion token (https://ion.cesium.com). Enables Cesium World Terrain in the 3D view.
# Without it the 3D view uses the elevation grid from the backend.
VITE_CESIUM_ION_TOKEN=
